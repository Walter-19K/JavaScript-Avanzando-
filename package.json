{
  "name": "technogaming-ap2-angular",
  "version": "1.0.0",
  "description": "Proyecto AP2 - JavaScript Avanzado: e-commerce Angular con Bootstrap y JSON Server.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "json-server": "json-server --watch db.json --port 3000 --host 0.0.0.0",
    "dev": "concurrently \"npm run json-server\" \"npm start\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "json-server": "^0.17.4",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "concurrently": "^8.2.2",
    "typescript": "~5.4.2"
  }
}